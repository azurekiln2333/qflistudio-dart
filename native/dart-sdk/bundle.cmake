set(QFLI_DART_SDK "" CACHE PATH "Dart SDK to bundle with the application")
if(NOT QFLI_DART_SDK)
  if(DEFINED ENV{QFLI_DART_SDK})
    set(QFLI_DART_SDK "$ENV{QFLI_DART_SDK}")
  else()
    include("${FLUTTER_MANAGED_DIR}/ephemeral/generated_config.cmake")
    set(QFLI_DART_SDK "${FLUTTER_ROOT}/bin/cache/dart-sdk")
  endif()
endif()
if(WIN32)
  set(QFLI_DART_BINARY "dart.exe")
else()
  set(QFLI_DART_BINARY "dart")
endif()
if(NOT EXISTS "${QFLI_DART_SDK}/bin/${QFLI_DART_BINARY}" OR
   NOT EXISTS "${QFLI_DART_SDK}/lib/core/core.dart")
  message(FATAL_ERROR "A complete native Dart SDK is required: ${QFLI_DART_SDK}")
endif()
if(CMAKE_CROSSCOMPILING)
  message(FATAL_ERROR "Bundle the Dart SDK on the target desktop host")
endif()
install(DIRECTORY "${QFLI_DART_SDK}/"
  DESTINATION "${INSTALL_BUNDLE_DATA_DIR}/dart-sdk"
  USE_SOURCE_PERMISSIONS COMPONENT Runtime)
