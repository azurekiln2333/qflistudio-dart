@@ -0,0 +1,316 @@
+import 'dart:io';
+
+import 'package:flutter/material.dart';
+import 'package:path/path.dart' as p;
+
+import '../i18n/studio_localizations.dart';
+import '../models/project.dart';
+import '../models/tutorial.dart';
+import '../services/app_paths.dart';
+import '../services/example_import_service.dart';
+import '../services/file_service.dart';
+import '../store/project_store.dart';
+
+typedef CodeImportResult = ({Project project, String filePath, bool created});
+
+Future<CodeImportResult?> showCodeImportDialog(
+  BuildContext context, {
+  required ProjectStore store,
+  required ExampleCode example,
+  bool toEditor = false,
+  String? projectLocation,
+}) => showDialog<CodeImportResult>(
+  context: context,
+  builder: (_) => _CodeImportDialog(
+    store: store,
+    example: example,
+    toEditor: toEditor,
+    projectLocation: projectLocation,
+  ),
+);
+
+class _CodeImportDialog extends StatefulWidget {
+  const _CodeImportDialog({
+    required this.store,
+    required this.example,
+    required this.toEditor,
+    this.projectLocation,
+  });
+
+  final ProjectStore store;
+  final ExampleCode example;
+  final bool toEditor;
+  final String? projectLocation;
+
+  @override
+  State<_CodeImportDialog> createState() => _CodeImportDialogState();
+}
+
+class _CodeImportDialogState extends State<_CodeImportDialog> {
+  static const _newProject = '@new-project';
+  late final TextEditingController _name;
+  late final TextEditingController _fileName;
+  late String _target;
+  String? _location;
+  String? _error;
+  bool _busy = false;
+  bool _resolving = false;
+
+  List<Project> get _projects =>
+      widget.store.projects.where((project) => !project.isCloud).toList();
+  bool get _creating => _target == _newProject;
+
+  Project? get _selectedProject {
+    for (final project in _projects) {
+      if (project.path == _target) return project;
+    }
+    return null;
+  }
+
+  @override
+  void initState() {
+    super.initState();
+    _name = TextEditingController(text: widget.example.title);
+    _fileName = TextEditingController(
+      text: ExampleImportService.defaultFileName(widget.example),
+    );
+    _target = widget.toEditor || _projects.isEmpty
+        ? _newProject
+        : _projects.first.path;
+    _location = widget.projectLocation;
+    if (_creating) _resolveLocation();
+  }
+
+  @override
+  void dispose() {
+    _name.dispose();
+    _fileName.dispose();
+    super.dispose();
+  }
+
+  Future<void> _resolveLocation() async {
+    if (_location != null || _resolving) return;
+    _resolving = true;
+    try {
+      final location = await AppPaths.projectsRoot(create: true);
+      if (!mounted) return;
+      setState(() {
+        _location = location;
+        if (location == null) {
+          _error = StudioLocalizations.of(context).noWorkingDirectory;
+        }
+      });
+    } finally {
+      if (mounted) setState(() => _resolving = false);
+    }
+  }
+
+  Future<bool> _confirmReplacement(String fileName) async {
+    final l10n = StudioLocalizations.of(context);
+    return await showDialog<bool>(
+          context: context,
+          builder: (context) => AlertDialog(
+            title: Text(l10n.replaceExistingResource),
+            content: Text(l10n.replaceResourceMessage(fileName)),
+            actions: [
+              TextButton(
+                onPressed: () => Navigator.pop(context, false),
+                child: Text(l10n.cancel),
+              ),
+              FilledButton(
+                onPressed: () => Navigator.pop(context, true),
+                child: Text(l10n.replaceResource),
+              ),
+            ],
+          ),
+        ) ??
+        false;
+  }
+
+  Future<void> _submit() async {
+    if (_busy || _resolving) return;
+    final l10n = StudioLocalizations.of(context);
+    final fileName = _fileName.text.trim();
+    if (!ExampleImportService.isValidFileName(fileName)) {
+      setState(() => _error = l10n.invalidFileName);
+      return;
+    }
+    if (_creating &&
+        (!FileService.isValidEntryName(_name.text) ||
+            _name.text.contains('\u0000'))) {
+      setState(() => _error = l10n.invalidProjectName);
+      return;
+    }
+    final selected = _selectedProject;
+    if (!_creating && selected == null) {
+      setState(() => _error = l10n.noProjects);
+      return;
+    }
+    if (_creating && _location == null) {
+      setState(() => _error = l10n.noWorkingDirectory);
+      return;
+    }
+    setState(() {
+      _busy = true;
+      _error = null;
+    });
+    try {
+      late final Project project;
+      late final String filePath;
+      final created = _creating;
+      if (created) {
+        final result = await widget.store.createProjectFromExample(
+          name: _name.text.trim(),
+          example: widget.example,
+          fileName: fileName,
+          location: _location,
+        );
+        if (!mounted) return;
+        if (result.error != null || result.project == null) {
+          setState(() => _error = result.error ?? l10n.importFailed);
+          return;
+        }
+        project = result.project!;
+        filePath = ExampleImportService.destinationPath(
+          project: project,
+          example: widget.example,
+          fileName: fileName,
+        );
+      } else {
+        project = selected!;
+        final target = ExampleImportService.destinationPath(
+          project: project,
+          example: widget.example,
+          fileName: fileName,
+        );
+        var overwrite = false;
+        if (await FileSystemEntity.type(target, followLinks: false) ==
+            FileSystemEntityType.file) {
+          if (!mounted) return;
+          overwrite = await _confirmReplacement(fileName);
+          if (!mounted || !overwrite) return;
+        }
+        filePath = await ExampleImportService.write(
+          project: project,
+          example: widget.example,
+          fileName: fileName,
+          overwrite: overwrite,
+        );
+      }
+      if (!mounted) return;
+      Navigator.of(
+        context,
+      ).pop((project: project, filePath: filePath, created: created));
+    } on Object catch (error) {
+      if (mounted) {
+        setState(() => _error = '${l10n.importFailed}: $error');
+      }
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = StudioLocalizations.of(context);
+    final projects = _projects;
+    final targets = {_newProject, for (final project in projects) project.path};
+    return PopScope<CodeImportResult>(
+      canPop: !_busy,
+      child: AlertDialog(
+        scrollable: true,
+        title: Text(
+          widget.toEditor ? l10n.importToEditor : l10n.importToProject,
+        ),
+        content: SizedBox(
+          width: 420,
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              if (!widget.toEditor) ...[
+                DropdownButtonFormField<String>(
+                  key: ValueKey(_target),
+                  initialValue: targets.contains(_target) ? _target : null,
+                  isExpanded: true,
+                  decoration: InputDecoration(labelText: l10n.targetProject),
+                  items: [
+                    for (final project in projects)
+                      DropdownMenuItem(
+                        value: project.path,
+                        child: Text(
+                          project.name,
+                          overflow: TextOverflow.ellipsis,
+                        ),
+                      ),
+                    DropdownMenuItem(
+                      value: _newProject,
+                      child: Text(l10n.newProject),
+                    ),
+                  ],
+                  onChanged: _busy
+                      ? null
+                      : (value) {
+                          if (value == null) return;
+                          setState(() {
+                            _target = value;
+                            _error = null;
+                          });
+                          if (_creating) _resolveLocation();
+                        },
+                ),
+                const SizedBox(height: 16),
+              ],
+              if (_creating) ...[
+                TextField(
+                  key: const ValueKey('import-project-name'),
+                  controller: _name,
+                  enabled: !_busy,
+                  decoration: InputDecoration(
+                    labelText: l10n.projectName,
+                    prefixIcon: const Icon(Icons.folder_outlined),
+                  ),
+                ),
+                const SizedBox(height: 16),
+              ],
+              TextField(
+                key: const ValueKey('import-file-name'),
+                controller: _fileName,
+                enabled: !_busy,
+                autofocus: true,
+                decoration: InputDecoration(
+                  labelText: l10n.fileName,
+                  prefixIcon: const Icon(Icons.insert_drive_file_outlined),
+                ),
+                onSubmitted: (_) => _submit(),
+              ),
+              if (_resolving || _busy) ...[
+                const SizedBox(height: 16),
+                const LinearProgressIndicator(),
+              ],
+              if (_error != null) ...[
+                const SizedBox(height: 12),
+                Text(
+                  _error!,
+                  style: TextStyle(color: Theme.of(context).colorScheme.error),
+                ),
+              ],
+            ],
+          ),
+        ),
+        actions: [
+          TextButton(
+            onPressed: _busy ? null : () => Navigator.pop(context),
+            child: Text(l10n.cancel),
+          ),
+          FilledButton.icon(
+            key: const ValueKey('import-code-confirm'),
+            onPressed: _busy || _resolving ? null : _submit,
+            icon: const Icon(Icons.open_in_new),
+            label: Text(l10n.importAndOpen),
+          ),
+        ],
+      ),
+    );
+  }
+}
