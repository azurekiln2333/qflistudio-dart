+    final codeStyle = theme.textTheme.bodyMedium?.copyWith(
+      fontFamily: EditorFonts.bundledFamily,
+    );
+    return DecoratedBox(
+      decoration: BoxDecoration(
+        color: theme.colorScheme.surfaceContainerLow,
+        border: Border.all(color: theme.colorScheme.outlineVariant),
+        borderRadius: BorderRadius.circular(8),
+      ),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          Padding(
+            padding: const EdgeInsets.fromLTRB(12, 4, 8, 12),
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.stretch,
+              children: [
+                Row(
+                  children: [
+                    Expanded(
+                      child: Text(
+                        l10n.sampleCode,
+                        style: theme.textTheme.titleSmall,
+                      ),
+                    ),
+                    IconButton(
+                      tooltip: l10n.copyExample,
+                      onPressed: _copying ? null : _copy,
+                      icon: const Icon(Icons.copy_outlined),
+                    ),
+                  ],
+                ),
+                Wrap(
+                  spacing: 8,
+                  runSpacing: 8,
+                  children: [
+                    FilledButton.tonalIcon(
+                      onPressed: canImport
+                          ? () => _import(toEditor: true)
+                          : null,
+                      icon: const Icon(Icons.edit_note_outlined),
+                      label: Text(l10n.importToEditor),
+                    ),
+                    OutlinedButton.icon(
+                      onPressed: canImport
+                          ? () => _import(toEditor: false)
+                          : null,
+                      icon: const Icon(Icons.drive_file_move_outlined),
+                      label: Text(l10n.importToProject),
+                    ),
+                  ],
+                ),
+              ],
+            ),
+          ),
+          const Divider(height: 1),
+          Padding(
+            padding: const EdgeInsets.all(12),
+            child: widget.controller != null
+                ? SizedBox(
+                    height: 360,
+                    child: TextField(
+                      controller: widget.controller,
+                      expands: true,
+                      minLines: null,
+                      maxLines: null,
+                      style: codeStyle,
+                      textAlignVertical: TextAlignVertical.top,
+                      decoration: const InputDecoration(
+                        border: InputBorder.none,
+                        isCollapsed: true,
+                      ),
+                    ),
+                  )
+                : ConstrainedBox(
+                    constraints: const BoxConstraints(maxHeight: 360),
+                    child: SingleChildScrollView(
+                      primary: false,
+                      child: SingleChildScrollView(
+                        scrollDirection: Axis.horizontal,
+                        child: SelectableText(
+                          widget.example.code,
+                          style: codeStyle,
+                        ),
+                      ),
+                    ),
+                  ),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Future<void> _copy() async {
+    if (_copying) return;
+    setState(() => _copying = true);
+    try {
+      await Clipboard.setData(ClipboardData(text: _currentCode));
+      if (!mounted) return;
+      ScaffoldMessenger.of(context).showSnackBar(
+        SnackBar(content: Text(StudioLocalizations.of(context).exampleCopied)),
+      );
+    } catch (error) {
+      if (!mounted) return;
+      ScaffoldMessenger.of(
+        context,
+      ).showSnackBar(SnackBar(content: Text(error.toString())));
+    } finally {
+      if (mounted) setState(() => _copying = false);
+    }
+  }
+
+  Future<void> _import({required bool toEditor}) async {
+    final store = widget.store;
+    final onOpenProject = widget.onOpenProject;
+    if (_importing || store == null || onOpenProject == null) return;
+    final example = widget.example.copyWith(code: _currentCode);
+    setState(() => _importing = true);
+    try {
+      final result = await showCodeImportDialog(
+        context,
+        store: store,
+        example: example,
+        toEditor: toEditor,
+      );
+      if (result == null || !mounted) return;
+      final auth = widget.auth;
+      if (result.created && auth != null) {
+        TaskActivityService.report(auth, 'create_project');
+      }
+      await onOpenProject(result.project, result.filePath);
+    } catch (error) {
+      if (!mounted) return;
+      ScaffoldMessenger.of(
+        context,
+      ).showSnackBar(SnackBar(content: Text(error.toString())));
+    } finally {
+      if (mounted) setState(() => _importing = false);
+    }
+  }
+}
