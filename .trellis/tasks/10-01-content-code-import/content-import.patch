@@ -0,0 +1,80 @@
+import 'dart:io';
+
+import 'package:path/path.dart' as p;
+
+import '../models/project.dart';
+import '../models/tutorial.dart';
+import 'file_service.dart';
+import 'project_templates.dart';
+
+abstract final class ExampleImportService {
+  static ProjectTemplate templateFor(ExampleCode example) =>
+      ProjectTemplate.fromType(example.type) ??
+      ProjectTemplate.fromType(example.type == 'html' ? 'web' : example.type) ??
+      ProjectTemplate.empty;
+
+  static String defaultFileName(ExampleCode example) =>
+      p.basename(templateFor(example).mainFile ?? 'src/example.txt');
+
+  static bool isValidFileName(String name) =>
+      FileService.isValidEntryName(name) && !name.contains('\u0000');
+
+  static String destinationPath({
+    required Project project,
+    required ExampleCode example,
+    required String fileName,
+  }) {
+    if (!isValidFileName(fileName)) {
+      throw const FileSystemException('Invalid file name');
+    }
+    final entry = templateFor(example).mainFile ?? 'src/example.txt';
+    return p.normalize(
+      p.join(p.absolute(project.path), p.dirname(entry), fileName.trim()),
+    );
+  }
+
+  static Future<String> write({
+    required Project project,
+    required ExampleCode example,
+    required String fileName,
+    bool overwrite = false,
+  }) async {
+    if (project.isCloud) {
+      throw const FileSystemException('Select a local project');
+    }
+    final destination = destinationPath(
+      project: project,
+      example: example,
+      fileName: fileName,
+    );
+    if (!await Directory(project.path).exists()) {
+      throw FileSystemException(
+        'Project directory does not exist',
+        project.path,
+      );
+    }
+    final file = File(destination);
+    if (await FileSystemEntity.type(file.parent.path, followLinks: false) ==
+        FileSystemEntityType.link) {
+      throw FileSystemException(
+        'Source directory is a symbolic link',
+        file.parent.path,
+      );
+    }
+    final type = await FileSystemEntity.type(destination, followLinks: false);
+    if (type != FileSystemEntityType.notFound &&
+        type != FileSystemEntityType.file) {
+      throw FileSystemException(
+        'Destination is not a regular file',
+        destination,
+      );
+    }
+    if (type == FileSystemEntityType.file && !overwrite) {
+      throw FileSystemException('File already exists', destination);
+    }
+    await file.parent.create(recursive: true);
+    if (!overwrite) await file.create(exclusive: true);
+    await file.writeAsString(example.code, flush: true);
+    return destination;
+  }
+}
