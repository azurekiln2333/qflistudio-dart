
{
  "apiType": 'stageMode',
  "buildOption": {
    "nativeLib": {
      "filter": {
        "excludes": ["**/x86_64/libqfli_git.so"]
      }
    },
    "externalNativeOptions": {
      "abiFilters": ["arm64-v8a"]
    }
  },
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS"
    },
    {
      "name": "ohosTest",
    }
  ]
}
